{
  "compilerOptions": {
    "strict": true,
    "target": "es2025",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    "lib": ["es2025"],
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "src/**/*", "vitest.config.ts"],
  "exclude": ["node_modules"]
}